package-as: DamageMeterCompanion

enable-nolib-creation: no

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# No externals: the addon deliberately has no library dependencies. Everything
# it needs is Blizzard's own damage meter and the stock Settings API.

ignore:
  - README.md
  - RELEASE_NOTES.md
  - .gitignore
  - .github
  - .busted
  - .superpowers
  - tools
  - CLAUDE.md
  # AGENTS.md is deliberately NOT ignored: the notice only does its job where
  # an agent actually reads the addon, which is the installed folder.
  - docs
  - tests
  - release-please-config.json
  - .release-please-manifest.json
